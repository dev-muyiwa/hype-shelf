# =============================================================================
# PUBLIC VARIABLES — Safe to expose to the browser
# =============================================================================

# Clerk publishable key (starts with pk_test_ or pk_live_)
# Obtained from: Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Convex deployment URL (ends with .convex.cloud)
# Obtained from: Convex Dashboard → Settings → URL & Deploy Key
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# =============================================================================
# PRIVATE VARIABLES — NEVER expose to the browser, NEVER prefix with NEXT_PUBLIC_
# =============================================================================

# Clerk secret key (starts with sk_test_ or sk_live_)
# Used for server-side Clerk API calls.
# NEVER put this in NEXT_PUBLIC_ — doing so would expose your entire Clerk
# account to anyone who inspects your client-side bundle.
CLERK_SECRET_KEY=sk_test_...

# Clerk webhook signing secret (starts with whsec_)
# Used to verify that incoming webhook requests genuinely came from Clerk,
# not a malicious third party spoofing Clerk's endpoint.
# NEVER put this in NEXT_PUBLIC_ — it would allow attackers to forge
# webhooks and write arbitrary data to your database.
CLERK_WEBHOOK_SECRET=whsec_...
